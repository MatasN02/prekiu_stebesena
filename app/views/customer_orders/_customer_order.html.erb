<div id="<%= dom_id customer_order %>" class="card">
  <div class="card-head">
    <h2 class="card-title"><%= customer_order.product_name %></h2>
    <span class="badge status-<%= customer_order.status.to_s.parameterize %>"><%= customer_order.status %></span>
  </div>

  <p class="meta">Kiekis: <strong><%= customer_order.quantity %></strong></p>
  <p class="meta">
    Numatomas pristatymas:
    <strong><%= l(customer_order.expected_delivery_at, format: :short) if customer_order.expected_delivery_at %></strong>
  </p>

  <div class="actions">
    <%= link_to "Peržiūrėti", customer_order_path(customer_order), class: "btn btn-small" %>
    <%= link_to "Redaguoti", edit_customer_order_path(customer_order), class: "btn btn-secondary btn-small" %>
    <%= link_to "Viešoji nuoroda", tracking_path(customer_order.tracking_token), class: "btn btn-secondary btn-small", target: "_blank" %>
    <%= link_to "Ištrinti", customer_order_path(customer_order), class: "btn btn-danger btn-small",
          data: { turbo_method: :delete, turbo_confirm: "Ar tikrai ištrinti šį užsakymą?" } %>
  </div>
</div>