<%= form_with(model: customer_order) do |form| %>
  <% if customer_order.errors.any? %>
    <div class="errors">
      <strong>Nepavyko išsaugoti:</strong>
      <ul>
        <% customer_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :product_name, "Produktas" %>
    <%= form.text_field :product_name %>
  </div>

  <div class="form-group">
    <%= form.label :quantity, "Kiekis" %>
    <%= form.number_field :quantity, min: 1 %>
  </div>

  <div class="form-group">
    <%= form.label :status, "Būsena" %>
    <%= form.select :status, CustomerOrder::STATUSES %>
  </div>

  <div class="form-group">
    <%= form.label :expected_delivery_at, "Numatomas pristatymas" %>
    <%= form.datetime_local_field :expected_delivery_at %>
  </div>

  <div class="actions">
    <%= form.submit "Išsaugoti" %>
    <%= link_to "Atšaukti", customer_orders_path, class: "btn btn-secondary" %>
  </div>
<% end %>